# === Banco de dados ===
POSTGRES_USER=unisism
POSTGRES_PASSWORD=unisism
POSTGRES_DB=unisism_ubs
POSTGRES_PORT=5432
DATABASE_URL="postgresql://unisism:unisism@localhost:5432/unisism_ubs?schema=public"

# === HTTP ===
NODE_ENV=development
PORT=3333
BACKEND_PORT=3333
CORS_ORIGIN=http://localhost:5173
# Em producao, mantenha false e use CORS_ORIGIN explicito. Em dev, previews Vercel podem ficar true.
CORS_ALLOW_VERCEL_PREVIEW=false
CORS_VERCEL_PROJECT=unisism
TRUST_PROXY=false
HSTS_MAX_AGE=15552000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=300000
SHUTDOWN_GRACE_MS=10000
API_KEY=
API_KEY_HEADER=x-api-key

# === Auth ===
JWT_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-um-refresh-forte
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
PASSWORD_HISTORY_SIZE=5
PASSWORD_VALIDITY_DAYS=180

# === Uploads ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# === Storage ===
# disk: grava em UPLOAD_DIR. s3: usa MinIO/AWS/Backblaze/etc.
STORAGE_PROVIDER=disk
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=unisism-anexos
S3_ACCESS_KEY=unisism
S3_SECRET_KEY=unisism12345
S3_FORCE_PATH_STYLE=true

# === Cache / filas / workers ===
REDIS_URL=redis://localhost:6379
CACHE_TTL_ARVORE=60
CACHE_TTL_DASHBOARD=30
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=500
PUSH_DISPATCHER_ENABLED=true
PUSH_DISPATCHER_INTERVAL_MS=15000
PUSH_DEVICE_CLEANUP_CRON="30 3 1 * *"
PUSH_DEVICE_CLEANUP_CRON_TZ=America/Recife
PUSH_DEVICE_TTL_DIAS=90
RECOVERY_PURGE_CRON="0 */6 * * *"
RECOVERY_PURGE_CRON_TZ=America/Recife
TFD_SALDO_CRON="30 0 1 * *"
TFD_SALDO_CRON_TZ=America/Recife

# === Email ===
# Em dev, "log" escreve os codigos no terminal. Em producao, use "smtp".
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="UNISISM <noreply@unisism.local>"
EMAIL_REPLY_TO=
APP_RESET_SENHA_URL=

# === Push ===
PUSH_PROVIDER=noop
NTFY_BASE_URL=http://localhost:8080
NTFY_PUBLIC_BASE_URL=http://localhost:8080
NTFY_AUTH_TOKEN=
NTFY_TIMEOUT_MS=10000

# === Antivírus ===
# Sem CLAMAV_HOST, o scanner fica no-op para dev.
CLAMAV_HOST=
CLAMAV_PORT=3310

# === Observabilidade ===
LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=unisism-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# === TFD / assinatura digital ===
TFD_SIGN_REQUIRED=false
TFD_SIGN_CERT_PATH=
TFD_SIGN_CERT_PASSWORD=

# === Demo/dev ===
# Cria dados demonstrativos no boot. Mantenha false em producao.
DEMO_SEED_ON_BOOT=false

# === Importacao PEC ===
PEC_BASE_URL=
PEC_USER=
PEC_PASSWORD=
PEC_HEADLESS=true
PEC_POOL_SIZE=4
PEC_RATE_DELAY_MS=3500
PEC_GLOBAL_RATE_HZ=6
