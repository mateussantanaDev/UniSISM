# Copie para .env.prod e substitua todos os valores REPLACE_* antes do deploy.

# === Dominio / HTTPS ===
UNISISM_DOMAIN=api.unisism.exemplo.com.br
ACME_EMAIL=admin@exemplo.com.br

# === Runtime HTTP ===
NODE_ENV=production
PORT=3333
BACKEND_PORT=3333
TRUST_PROXY=true
HSTS_MAX_AGE=15552000
CORS_ORIGIN=https://unisism.vercel.app
CORS_ALLOW_VERCEL_PREVIEW=false
CORS_VERCEL_PROJECT=unisism
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=300000
SHUTDOWN_GRACE_MS=10000
API_KEY=
API_KEY_HEADER=x-api-key

# === Banco de dados ===
POSTGRES_USER=unisism
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=unisism_ubs
POSTGRES_PORT=5432
DATABASE_URL=postgresql://unisism:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/unisism_ubs?schema=public

# === Auth ===
JWT_SECRET=REPLACE_WITH_STRONG_48_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_48_CHAR_SECRET
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_HISTORY_SIZE=5
PASSWORD_VALIDITY_DAYS=180

# === Storage S3/MinIO ===
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=unisism-anexos
S3_ACCESS_KEY=unisism
S3_SECRET_KEY=REPLACE_WITH_STRONG_S3_SECRET
S3_FORCE_PATH_STYLE=true
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# === Redis / workers ===
REDIS_URL=redis://redis:6379
CACHE_TTL_ARVORE=60
CACHE_TTL_DASHBOARD=30
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=500
PUSH_DISPATCHER_ENABLED=true
PUSH_DISPATCHER_INTERVAL_MS=15000
PUSH_DEVICE_CLEANUP_CRON="30 3 1 * *"
PUSH_DEVICE_CLEANUP_CRON_TZ=America/Recife
PUSH_DEVICE_TTL_DIAS=90
RECOVERY_PURGE_CRON="0 */6 * * *"
RECOVERY_PURGE_CRON_TZ=America/Recife
TFD_SALDO_CRON="30 0 1 * *"
TFD_SALDO_CRON_TZ=America/Recife

# === Email SMTP ===
EMAIL_PROVIDER=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_SECURE=false
EMAIL_FROM="UNISISM <noreply@unisism.exemplo.com.br>"
EMAIL_REPLY_TO=
APP_RESET_SENHA_URL=https://unisism.vercel.app/redefinir

# === Push ===
PUSH_PROVIDER=ntfy
NTFY_BASE_URL=http://ntfy
NTFY_PUBLIC_BASE_URL=https://push.unisism.exemplo.com.br
NTFY_AUTH_TOKEN=
NTFY_TIMEOUT_MS=10000

# === Antivírus ===
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# === Observabilidade ===
LOG_LEVEL=info
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=unisism-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# === TFD / assinatura digital ===
TFD_SIGN_REQUIRED=false
TFD_SIGN_CERT_PATH=
TFD_SIGN_CERT_PASSWORD=

# === Demo/dev ===
DEMO_SEED_ON_BOOT=false
