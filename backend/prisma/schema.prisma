// ======================================================================
// Schema Prisma — Backend UNISISM · UBS
// Modela todos os agregados consumidos pelo frontend (Face 1 / UBS).
// ======================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum RoleAtendente {
  DESENVOLVEDOR     // acesso global (todas prefeituras / UBSs)
  ADMIN             // admin de uma prefeitura — vê todas UBSs daquela prefeitura
  COORDENADOR_UBS   // coordena uma UBS — vê apenas dados da UBS
  ATENDENTE_UBS     // atendente de uma UBS — vê apenas dados da UBS
  REGULADOR_SMS     // regulador da SMS de uma prefeitura
  GESTOR_TFD        // gestor de Tratamento Fora do Domicílio (Face 4) — frota, motoristas, viagens, ajuda de custo
  ATENDENTE_TFD     // atendente TFD (terminal rodoviário) — apenas cadastra solicitações de viagem
  MOTORISTA_TFD     // motorista TFD com app mobile próprio (UNISISM-motorista) — vê só suas viagens
  REGULADOR_TFD     // regulador TFD — cadastro de passageiros e solicitações
  MEDICO            // médico (CEO/CEM/UBS)
  MEDICO_ESPECIALISTA // médico especialista do Centro de Especialidades / CEO
  ATENDENTE_CENTRO    // atendente/recepcionista do Centro de Especialidades / CEO
}

enum Sexo {
  M
  F
  OUTRO
}

enum StatusEncaminhamento {
  RASCUNHO
  AGUARDANDO_REGULACAO
  PENDENCIA_DOCUMENTO
  APROVADO
  REJEITADO
}

enum CanalRoteamento {
  SUS
  CENTRO_ESPECIALIDADES
  CENTRO_ODONTOLOGICO
}

enum DestinoRegulacao {
  SUS
  CENTRO_ESPECIALIDADES
  CENTRO_ODONTOLOGICO
}

enum StatusAtendimentoCentro {
  AGENDADO
  AGUARDANDO_ATENDIMENTO
  EM_ATENDIMENTO
  CONCLUIDO
  FALTOU
}

enum PrioridadeClinica {
  ELETIVA
  PRIORITARIA
  URGENTE
  EMERGENCIA
}

enum TipoAnexo {
  SOLICITACAO
  RG
  CPF
  CARTAO_SUS
  EXAME
  LAUDO
  RESPOSTA_SUS
  OUTRO
}

enum TipoEventoTimeline {
  CRIADO
  DOCUMENTO_ANEXADO
  ENVIADO_REGULACAO
  PENDENCIA_REGISTRADA
  APROVADO
  REJEITADO
  AGENDADO
  OBSERVACAO
  RESPOSTA_SUS_RECEBIDA
  EDITADO
  REMARCACAO
}

enum TipoNotificacaoPaciente {
  ENCAMINHAMENTO_CRIADO
  PENDENCIA_REGISTRADA
  PENDENCIA_RESOLVIDA
  APROVADO
  AGENDADO
  REJEITADO
  RESPOSTA_SUS_DISPONIVEL
}

enum GrupoSanguineo {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
  NAO_INFORMADO
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  OUTRO
}

enum RacaCor {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_INFORMADA
}

enum TipoAlergia {
  MEDICAMENTO
  ALIMENTO
  AMBIENTAL
  OUTRO
}

enum GravidadeAlergia {
  LEVE
  MODERADA
  GRAVE
}

enum TipoAtendimento {
  CONSULTA_MEDICA
  ENFERMAGEM
  VACINACAO
  CURATIVO
  ODONTOLOGICO
  PROCEDIMENTO
  ACOLHIMENTO
}

enum StatusViagemTFD {
  AGENDADA
  REALIZADA
  CANCELADA
  EM_ANDAMENTO
}

enum TransporteTFD {
  VAN_SMS
  AMBULANCIA
  PASSAGEM_RODOVIARIA
  PASSAGEM_AEREA
}

enum CategoriaExame {
  LABORATORIAL
  IMAGEM
  FUNCIONAL
  OUTROS
}

enum ResultadoExame {
  NORMAL
  ALTERADO
  CRITICO
  PENDENTE
}

enum ViaAplicacaoVacina {
  INTRAMUSCULAR
  SUBCUTANEA
  ORAL
  INTRADERMICA
}

enum TipoRelatorio {
  PRODUCAO_INDIVIDUAL
  ENCAMINHAMENTOS_POR_ESPECIALIDADE
  FILA_REGULACAO
  PENDENCIAS_RESOLVIDAS
  TFD_CUSTOS
  VACINACAO_UBS
  BUSCA_ATIVA
}

enum FormatoRelatorio {
  PDF
  CSV
  XLSX
}

enum StatusRelatorio {
  DISPONIVEL
  PROCESSANDO
  FALHA
}

// ============================================================
// UBS + Atendentes + Auth
// ============================================================

model Prefeitura {
  id         String    @id @default(uuid())
  nome       String
  municipio  String
  uf         String    @default("PE")
  cnpj       String?   @unique
  ativa      Boolean   @default(true)
  deletadoEm DateTime?

  ubs        Ubs[]
  atendentes Atendente[]
  relatorios Relatorio[] @relation("RelatorioPrefeitura")

  // Face 4 (TFD)
  veiculosTfd     VeiculoTFD[]      @relation("VeiculoPrefeitura")
  motoristasTfd   MotoristaTFD[]    @relation("MotoristaPrefeitura")
  solicitacoesTfd SolicitacaoTFD[]  @relation("SolicTfdPrefeitura")
  viagensFrota    ViagemFrota[]     @relation("ViagemFrotaPrefeitura")
  abastecimentos  Abastecimento[]   @relation("AbastPrefeitura")
  saldosVeiculos  SaldoVeiculo[]    @relation("SaldoVeicPrefeitura")
  ajudasCusto     AjudaCusto[]      @relation("AjudaPrefeitura")
  tfdAuditLogs    TfdAuditLog[]     @relation("TfdAuditPrefeitura")
  smsBanners      SmsBanner[]       @relation("BannerPrefeitura")

  // v0.18.0 merge — TFD financeiro do remote
  saldosAjudaCusto   SaldoAjudaCusto[]       @relation("SaldoAjudaPrefeitura")
  aportesFrota       AporteSaldoFrota[]      @relation("AporteFrotaPrefeitura")
  aportesAjudaCusto  AporteSaldoAjudaCusto[] @relation("AporteAjudaPrefeitura")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("prefeituras")
}

model Ubs {
  id         String    @id @default(uuid())
  nome       String
  municipio  String
  uf         String    @default("PE")
  endereco   String?
  cnes       String?   @unique
  ativa      Boolean   @default(true)
  deletadoEm DateTime?

  /// Endereço completo (campos auxiliares para UI bonita do app paciente).
  bairro     String?   @db.VarChar(120)
  cep        String?   @db.VarChar(9)         // formato "00000-000"

  /// Contato (mostrados no app paciente § "Minha UBS")
  telefone   String?   @db.VarChar(20)        // somente dígitos (10/11) ou E.164
  whatsapp   String?   @db.VarChar(20)
  email      String?   @db.VarChar(180)       // institucional

  /// Geolocalização (mapa no app — opcional)
  latitude   Decimal?  @db.Decimal(9, 6)      // -90 a 90
  longitude  Decimal?  @db.Decimal(9, 6)      // -180 a 180

  /// Horários de funcionamento — JSON estruturado:
  /// {
  ///   "segunda": { "abre": "07:00", "fecha": "17:00" },
  ///   "terca":   { "abre": "07:00", "fecha": "17:00" },
  ///   ...
  ///   "sabado":  null,   // fechado
  ///   "domingo": null
  /// }
  horarios   Json?

  /// Observações livres (max ~500 chars na UI). Útil para "ponto de referência", "ramal", etc.
  observacoes String?  @db.Text

  prefeituraId String
  prefeitura   Prefeitura @relation(fields: [prefeituraId], references: [id])

  atendentes      Atendente[]
  pacientes       Paciente[]
  encaminhamentos Encaminhamento[]
  relatorios      Relatorio[] @relation("RelatorioUbs")
  solicitacoesTfd SolicitacaoTFD[] @relation("SolicTfdUbs")
  /// Contas do app paciente vinculadas a esta UBS (Face 3).
  contasPaciente  PacienteConta[] @relation("PacienteContaUbs")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([prefeituraId])
  @@map("ubs")
}

model Atendente {
  id              String        @id @default(uuid())
  matricula       String        @unique
  nome            String
  email           String        @unique
  senhaHash       String
  cpf             String        @unique
  telefone        String?
  dataNascimento  DateTime?
  cargo           String        @default("ATENDENTE DE REGULAÇÃO")
  funcao          String        @default("Operador do canal de ingestão de encaminhamentos")
  role            RoleAtendente @default(ATENDENTE_UBS)
  ativo           Boolean       @default(true)
  bloqueadoAte    DateTime?
  dataAdmissao    DateTime?

  twoFAAtivo  Boolean @default(false)
  metodoTwoFA String?

  senhaAlteradaEm DateTime @default(now())
  deletadoEm      DateTime?

  // Vinculação de Unidade (CEO / CEM / UBS / SMS / TFD)
  tipoUnidade  String?   @map("tipo_unidade") @db.VarChar(20)
  unidadeId    String?   @map("unidade_id")

  // Escopo: DESENVOLVEDOR não tem nem ubsId nem prefeituraId.
  //         ADMIN/REGULADOR_SMS têm prefeituraId (sem ubsId).
  //         ATENDENTE_UBS/COORDENADOR_UBS têm ubsId (e herdam prefeituraId via UBS).
  ubsId        String?
  ubs          Ubs?        @relation(fields: [ubsId], references: [id])
  prefeituraId String?
  prefeitura   Prefeitura? @relation(fields: [prefeituraId], references: [id])

  criadoPorId String?
  criadoPor   Atendente?  @relation("CriadoPor", fields: [criadoPorId], references: [id])
  criou       Atendente[] @relation("CriadoPor")

  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetCode[]
  tentativasLogin TentativaLogin[]
  sessoes         Sessao[]
  auditoria       AuditoriaLog[]
  encaminhamentos Encaminhamento[]
  relatorios      Relatorio[]
  atividades      AtividadeAtendente[]

  // Face 4 (TFD · motorista) — 1:1 com perfil operacional na frota
  motoristaTfd MotoristaTFD? @relation("AtendenteMotorista")

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("atendentes")
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  expiraEm    DateTime
  revogadoEm  DateTime?
  sessaoId    String?  @unique
  sessao      Sessao?  @relation(fields: [sessaoId], references: [id], onDelete: SetNull)
  userAgent   String?
  ip          String?

  criadoEm DateTime @default(now())

  @@map("refresh_tokens")
}

model Sessao {
  id          String   @id @default(uuid())
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  dispositivo String?
  local       String?
  ultimoUsoEm DateTime @default(now())
  expiraEm    DateTime
  revogadaEm  DateTime?
  refreshToken RefreshToken?

  criadaEm DateTime @default(now())

  @@map("sessoes")
}

model PasswordResetCode {
  id          String   @id @default(uuid())
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  codigoHash  String
  resetToken  String?  @unique
  expiraEm    DateTime
  consumidoEm DateTime?
  tentativas  Int      @default(0)

  criadoEm DateTime @default(now())

  @@map("password_reset_codes")
}

model TentativaLogin {
  id          String   @id @default(uuid())
  login       String
  ip          String?
  userAgent   String?
  sucesso     Boolean
  atendenteId String?
  atendente   Atendente? @relation(fields: [atendenteId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  @@index([login, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

model AuditoriaLog {
  id          String   @id @default(uuid())
  acao        String
  recurso     String
  recursoId   String?
  payload     Json?
  atendenteId String?
  atendente   Atendente? @relation(fields: [atendenteId], references: [id], onDelete: SetNull)
  ip          String?
  userAgent   String?

  criadoEm DateTime @default(now())

  @@index([recurso, recursoId])
  @@index([atendenteId, criadoEm])
  @@map("auditoria_logs")
}

model AtividadeAtendente {
  id          String   @id @default(uuid())
  atendenteId String
  atendente   Atendente @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  acao        String
  alvo        String?
  em          DateTime @default(now())

  @@index([atendenteId, em])
  @@map("atividades_atendente")
}

// ============================================================
// PACIENTE (PEC)
// ============================================================

model Paciente {
  id               String   @id @default(uuid())
  nome             String
  nomeSocial       String?
  cpf              String   @unique
  cartaoSus        String?  @unique  // pode ser null quando paciente não tem CSUS na hora do cadastro
  dataNascimento   DateTime
  sexo             Sexo
  telefone         String?
  telefoneSecundario String?
  email            String?

  nomeMae     String?
  nomePai     String?
  estadoCivil EstadoCivil @default(OUTRO)
  escolaridade String?
  profissao    String?
  racaCor     RacaCor @default(NAO_INFORMADA)

  endereco  String?
  bairro    String?
  municipio String?
  uf        String?
  cep       String?

  grupoSanguineo GrupoSanguineo @default(NAO_INFORMADO)
  historicoFamiliar String[]    @default([])

  agenteComunitario String?
  microarea         String?
  equipeSaudeFamilia String?

  ubsId String
  ubs   Ubs    @relation(fields: [ubsId], references: [id])

  alergias          Alergia[]
  condicoesCronicas CondicaoCronica[]
  medicamentosEmUso MedicamentoEmUso[]
  atendimentos      Atendimento[]
  viagensTFD        ViagemTFD[]
  exames            ExameRealizado[]
  vacinacoes        VacinaAplicada[]
  medicosAtendentes MedicoAtendente[]
  encaminhamentos   Encaminhamento[]

  // Face 4 (TFD)
  solicitacoesTfd        SolicitacaoTFD[]
  viagemPassageiroLista  ViagemPassageiro[] @relation("PacienteViagemPassageiro")
  ajudasCusto            AjudaCusto[]       @relation("PacienteAjudaCusto")
  agendamentosCentro     AgendamentoCentro[]

  cadastradoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  deletadoEm   DateTime?

  @@index([ubsId])
  @@index([nome])
  @@map("pacientes")
}

model Alergia {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  substancia String
  tipo       TipoAlergia
  gravidade  GravidadeAlergia
  observacao String?

  @@map("alergias")
}

model CondicaoCronica {
  id         String   @id @default(uuid())
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  cid10      String
  descricao  String
  desde      DateTime
  ativo      Boolean  @default(true)
  observacao String?

  @@map("condicoes_cronicas")
}

model MedicamentoEmUso {
  id          String   @id @default(uuid())
  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  nome        String
  dosagem     String
  frequencia  String
  desde       DateTime
  prescritor  String
  ativo       Boolean  @default(true)

  @@map("medicamentos_em_uso")
}

model Atendimento {
  id                   String          @id @default(uuid())
  pacienteId           String
  paciente             Paciente        @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  data                 DateTime
  tipo                 TipoAtendimento
  profissional         String
  registroProfissional String
  especialidade        String
  unidade              String
  queixaPrincipal      String
  diagnostico          String
  cid10                String
  conduta              String
  prescricaoResumo     String?
  procedimentosRealizados AtendimentoProcedimentoRealizado[]

  @@index([pacienteId, data])
  @@map("atendimentos")
}

model ViagemTFD {
  id                String          @id @default(uuid())
  protocolo         String          @unique
  pacienteId        String
  paciente          Paciente        @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  dataIda           DateTime
  dataVolta         DateTime
  destino           String
  unidadeDestino    String
  motivo            String
  especialidade     String
  acompanhante      Boolean         @default(false)
  transporte        TransporteTFD
  status            StatusViagemTFD @default(AGENDADA)
  custoEstimadoBRL  Float           @default(0)

  criadaEm   DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@index([pacienteId])
  @@map("viagens_tfd")
}

model ExameRealizado {
  id                String         @id @default(uuid())
  pacienteId        String
  paciente          Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  data              DateTime
  tipo              String
  categoria         CategoriaExame
  solicitante       String
  unidadeExecutora  String
  resultado         ResultadoExame
  observacao        String?

  @@index([pacienteId, data])
  @@map("exames_realizados")
}

model VacinaAplicada {
  id         String              @id @default(uuid())
  pacienteId String
  paciente   Paciente            @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  data       DateTime
  vacina     String
  dose       String
  lote       String
  aplicador  String
  unidade    String
  via        ViaAplicacaoVacina

  @@index([pacienteId, data])
  @@map("vacinas_aplicadas")
}

model MedicoAtendente {
  id              String   @id @default(uuid())
  pacienteId      String
  paciente        Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  nome            String
  registro        String
  especialidade   String
  unidade         String
  ultimaConsulta  DateTime
  totalConsultas  Int      @default(1)

  @@map("medicos_atendentes")
}

// ============================================================
// ENCAMINHAMENTOS
// ============================================================

model Encaminhamento {
  id              String               @id @default(uuid())
  protocolo       String               @unique
  status          StatusEncaminhamento @default(AGUARDANDO_REGULACAO)
  canalRoteamento CanalRoteamento?
  destinoRegulacao DestinoRegulacao?
  dataDisponibilidade DateTime?

  // Paciente (snapshot + FK quando reconhecido)
  pacienteId String?
  paciente   Paciente? @relation(fields: [pacienteId], references: [id])
  pacienteNome         String
  pacienteCpf          String
  pacienteCartaoSus    String
  pacienteDataNascimento DateTime
  pacienteSexo         Sexo
  pacienteTelefone     String
  pacienteEndereco     String

  // Solicitação médica
  medicoSolicitante       String
  crm                     String
  especialidadeSolicitada String
  cid10                   String
  cidDescricao            String
  justificativaClinica    String
  prioridade              PrioridadeClinica
  dataSolicitacao         DateTime

  observacoesRegulacao String?
  agendamentoPrevisto  DateTime?
  statusAtendimentoCentro StatusAtendimentoCentro? @default(AGENDADO)
  presencaRegistradaEm   DateTime?
  atendimentoIniciadoEm  DateTime?
  atendimentoConcluidoEm DateTime?

  // Detalhes do agendamento (preenchidos pela Regulação no fluxo de aprovação).
  // Usados pelo app do paciente pra mostrar "Sua consulta" rica.
  localAgendamento     String?
  profissionalAgendado String?
  /// Cidade onde a consulta ocorre — campo EXPLÍCITO (não derivar do localAgendamento).
  /// Usado pra `podeSolicitarTfd` (compara com município da UBS de origem).
  cidadeAgendamento    String?
  /// UF do agendamento. Default "BA" mas explícito pra TFD interestadual.
  ufAgendamento        String?   @db.Char(2)
  /// Motivo da rejeição (espelha conteúdo da timeline RJEITADO — flat pro app).
  motivoRejeicao       String?
  /// Recomendações "o que levar no dia" — string[] curto por especialidade.
  recomendacoes        Json?

  // Resposta SUS Federal (enrichment pós-aprovação)
  respostaSusAnexoId           String?
  respostaSusObservacao        String?
  respostaSusRegistradoEm      DateTime?
  respostaSusRegistradoPorId   String?
  respostaSusRegistradoPorNome String?
  respostaSusRegistradoPorMat  String?

  unidadeOrigem        String
  atendenteResponsavel String

  ubsId         String
  ubs           Ubs       @relation(fields: [ubsId], references: [id])
  atendenteId   String
  atendente     Atendente @relation(fields: [atendenteId], references: [id])

  // Trilha de Auditoria com Identificação de Operador
  criadoPorId       String?
  criadoPorNome     String?
  atualizadoPorId   String?
  atualizadoPorNome String?
  deletadoPorId     String?
  deletadoPorNome   String?
  motivoExclusao    String?

  anexos   AnexoDocumento[]
  timeline EventoTimeline[]
  /// Pedidos TFD que anexaram este encaminhamento p/ ganhar prioridade.
  tfdSolicitacoes TfdPacienteSolicitacao[] @relation("TfdEncaminhamento")

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  deletadoEm  DateTime?

  @@index([ubsId, status, criadoEm])
  @@index([pacienteId])
  @@index([atendenteId])
  @@map("encaminhamentos")
}

enum StatusScanAnexo {
  PENDENTE
  LIMPO
  INFECTADO
  FALHOU
}

model AnexoDocumento {
  id               String    @id @default(uuid())
  encaminhamentoId String
  encaminhamento   Encaminhamento @relation(fields: [encaminhamentoId], references: [id], onDelete: Cascade)
  nome             String
  tipo             TipoAnexo
  tamanhoKb        Int
  mimeType         String
  caminho          String
  sha256           String?
  scanStatus       StatusScanAnexo @default(PENDENTE)
  scanEm           DateTime?
  uploadEm         DateTime  @default(now())

  @@index([encaminhamentoId])
  @@index([scanStatus])
  @@map("anexos_documentos")
}

model EventoTimeline {
  id               String             @id @default(uuid())
  encaminhamentoId String
  encaminhamento   Encaminhamento     @relation(fields: [encaminhamentoId], references: [id], onDelete: Cascade)
  tipo             TipoEventoTimeline
  titulo           String
  descricao        String
  autor            String
  autorPapel       String
  em               DateTime           @default(now())

  @@index([encaminhamentoId, em])
  @@map("eventos_timeline")
}

// ============================================================
// RELATÓRIOS
// ============================================================

enum AcaoAuditRelatorio {
  CRIADO
  DOWNLOAD
  FALHA
  EXPIRADO
  EXCLUIDO
}

/**
 * Job de relatório (LGPD-first).
 * Spec completa: backend/docs/RELATORIOS.md
 */
model Relatorio {
  id             String           @id @default(uuid())
  tipo           TipoRelatorio
  titulo         String           // "Fila de Regulação · Abr/2026" — backend monta
  periodoIni     DateTime
  periodoFim     DateTime
  formato        FormatoRelatorio
  status         StatusRelatorio  @default(PROCESSANDO)
  filtros        Json             @default("{}")
  erroTraceId    String?

  // Autoria & escopo RBAC
  atendenteId    String
  atendente      Atendente   @relation(fields: [atendenteId], references: [id], onDelete: Cascade)
  prefeituraId   String
  prefeituraRel  Prefeitura  @relation("RelatorioPrefeitura", fields: [prefeituraId], references: [id])
  ubsId          String?
  ubsRel         Ubs?        @relation("RelatorioUbs", fields: [ubsId], references: [id])

  // Storage
  storageKey     String?    // S3 key ou caminho relativo
  contentType    String?
  tamanhoBytes   BigInt?
  tamanhoKb      Int        @default(0) // derivado de tamanhoBytes/1024 (compat com frontend)
  hashSha256     String?    // não-repúdio

  // Ciclo de vida
  geradoEm       DateTime   @default(now()) // criadoEm do job
  finalizadoEm   DateTime?                  // quando worker terminou
  expiraEm       DateTime                   // now() + 7 dias (TTL LGPD)
  downloads      Int        @default(0)
  ultimoDownload DateTime?

  auditoria      RelatorioAudit[]

  @@index([atendenteId, geradoEm(sort: Desc)])
  @@index([prefeituraId, geradoEm(sort: Desc)])
  @@index([status, geradoEm])
  @@index([expiraEm])
  @@map("relatorio_job")
}

/**
 * Recomendações ("o que levar no dia") por especialidade médica.
 * Mostradas no app paciente no detalhe do encaminhamento.
 *
 * Chave: nome canônico da especialidade (case-insensitive na busca).
 * Escopo: global. Pode evoluir pra ter `prefeituraId` se prefeituras quiserem
 * customizar, mas no MVP é compartilhado.
 *
 * CRUD via Face 2 (`/v1/admin/recomendacoes-especialidade/*` — só DEV/ADMIN/REGULADOR_SMS).
 */
model EspecialidadeRecomendacao {
  id            String   @id @default(uuid())
  /// Ex.: "Cardiologia", "Endocrinologia", "Ortopedia". Case-insensitive na busca.
  especialidade String   @unique
  /// Array de bullets curtos (≤ 120 chars cada). Tipicamente 3-6 itens.
  recomendacoes Json     // string[]
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  criadoPorId   String?

  @@map("especialidade_recomendacoes")
}

/**
 * Auditoria imutável de relatórios (append-only). Retenção mínima 5 anos
 * por exigência da LGPD art. 37 + boa prática setor público.
 */
model RelatorioAudit {
  id           BigInt   @id @default(autoincrement())
  relatorioId  String
  relatorio    Relatorio @relation(fields: [relatorioId], references: [id])
  atendenteId  String
  acao         AcaoAuditRelatorio
  ip           String?
  userAgent    String?
  detalhes     Json?     // snapshot dos filtros no CRIADO, motivo no FALHA, etc.
  em           DateTime  @default(now())

  @@index([relatorioId, em(sort: Desc)])
  @@index([atendenteId, em(sort: Desc)])
  @@map("relatorio_audit")
}

// ============================================================
// Contadores sequenciais (para protocolos UBS-AAAA-NNNNNN etc.)
// ============================================================

model SequencialProtocolo {
  chave String @id
  valor Int    @default(0)

  @@map("sequenciais_protocolo")
}

// ============================================================
// APP DO PACIENTE (Face 3)
// ============================================================

/**
 * Conta de acesso do paciente no app.
 * A chave é o CPF (normalizado sem pontuação).
 * O paciente pode ter múltiplos encaminhamentos (em múltiplas UBSs/prefeituras).
 */
model PacienteConta {
  id         String @id @default(uuid())
  cpf        String @unique // "12345678900" (dígitos)
  cpfFormatado String // "123.456.789-00"
  nome       String
  email      String?
  telefone   String?
  senhaHash  String
  ativo      Boolean @default(true)
  // true quando a senha ainda é o CPF (padrão de primeira criação).
  // O app do paciente DEVE forçar troca de senha antes de prosseguir.
  senhaProvisoria Boolean @default(false)

  /// UBS vinculada (definida na criação automática da conta, na consolidação do
  /// 1º encaminhamento via Face 1). Permite o app mostrar a tela "Minha UBS".
  ubsVinculadaId String?
  ubsVinculada   Ubs?    @relation("PacienteContaUbs", fields: [ubsVinculadaId], references: [id])

  sessoesPaciente       SessaoPaciente[]
  refreshTokensPaciente PacienteRefreshToken[]
  notificacoes          NotificacaoPaciente[]
  recoveryTokens        PacienteRecoveryToken[]
  dispositivos          PacienteDispositivo[]
  bannerViews           SmsBannerView[]            @relation("BannerView")
  tfdSolicitacoes       TfdPacienteSolicitacao[]   @relation("TfdContaSolic")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pacientes_contas")
}

// ============================================================
// Recuperação de senha (P0 — esqueci-senha / redefinir-senha)
// ============================================================

/// Token opaco enviado por email para o paciente redefinir senha.
/// Uso único, TTL 30 minutos.
model PacienteRecoveryToken {
  id          String   @id @default(uuid())
  contaId     String
  conta       PacienteConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique  // SHA-256(token)
  expiraEm    DateTime
  usadoEm     DateTime?
  ipOrigem    String?
  userAgent   String?
  criadoEm    DateTime @default(now())

  @@index([contaId])
  @@index([expiraEm])
  @@map("paciente_recovery_tokens")
}

// ============================================================
// FCM push notifications (P1)
// ============================================================

enum PlataformaPush {
  ANDROID
  IOS
}

/// Provider de push usado pelo dispositivo do paciente.
/// `NTFY` — ntfy.sh self-hosted (open-source, padrão UNISISM)
/// `FCM`  — legado/compat (Firebase Cloud Messaging — não recomendado para SUS)
/// `WEB_PUSH` — Web Push API (RFC 8030) — para PWAs futuros
enum PushProvider {
  NTFY
  FCM
  WEB_PUSH
}

/// Dispositivos registrados pelo paciente pra receber push notifications.
/// `endpoint` UNIQUE globalmente — se cidadão trocar de conta no mesmo device,
/// o endpoint muda de dono via UPSERT (audit registra a transferência).
///
/// Campo `endpoint`:
///   - NTFY: nome do topic (`https://ntfy.host/<topic>`). Topic é UUID por device.
///   - FCM: token FCM (legacy support — Firebase desabilitado por padrão na SMS).
///   - WEB_PUSH: endpoint serializado JSON (`{endpoint, keys: {p256dh, auth}}`)
model PacienteDispositivo {
  id              String   @id @default(uuid())
  contaId         String
  conta           PacienteConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  endpoint        String   @unique  // antes: `fcmToken`
  provider        PushProvider @default(NTFY)
  plataforma      PlataformaPush
  appVersion      String?
  /// Quando recebeu o último push com sucesso (usado pra cleanup).
  ultimoSucessoEm DateTime?
  /// Contagem de falhas consecutivas (atinge ${CLEANUP_FALHAS_LIMITE} → tokens removido).
  falhasConsecutivas Int   @default(0)
  ultimaAtividade DateTime @default(now())
  criadoEm        DateTime @default(now())

  @@index([contaId])
  @@index([provider, ultimaAtividade])
  @@map("paciente_dispositivos")
}

model SessaoPaciente {
  id          String @id @default(uuid())
  contaId     String
  conta       PacienteConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tokenHash   String @unique
  ip          String?
  userAgent   String?
  expiraEm    DateTime
  revogadaEm  DateTime?
  criadaEm    DateTime @default(now())

  // Refresh token que originou esta sessão (1:1 — facilita rotação encadeada)
  refreshTokenId String? @unique
  refreshToken   PacienteRefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@map("sessoes_paciente")
}

/// Refresh token rotativo do app paciente (Face 3 · v0.18.0+).
///
/// Comportamento:
///   - Login emite par (access opaco 30 min + refresh opaco 30 dias).
///   - `POST /auth/refresh` consome o refresh atual:
///     - Marca `usadoEm` no antigo e link `substituidoPorId` para o novo.
///     - Emite novo par (access + refresh).
///   - Detecção de reuse: se receber refresh com `usadoEm != null`,
///     REVOGA TODA A CADEIA da conta (sinal de vazamento/clone).
///   - TTL: 30 dias. Logout marca `revogadoEm` em todos da conta.
model PacienteRefreshToken {
  id        String @id @default(uuid())
  contaId   String
  conta     PacienteConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiraEm  DateTime
  ip        String?
  userAgent String?

  // Rotação — quando usado, aponta pro filho que o substituiu
  usadoEm          DateTime?
  substituidoPorId String? @unique
  substituidoPor   PacienteRefreshToken? @relation("PacRefreshChain", fields: [substituidoPorId], references: [id], onDelete: SetNull)
  substituiu       PacienteRefreshToken? @relation("PacRefreshChain")

  // Revogação explícita
  revogadoEm      DateTime?
  motivoRevogacao String?   // LOGOUT | REUSE_DETECTED | CONTA_INATIVA | CHAIN_COMPROMISED

  criadoEm DateTime @default(now())

  sessao SessaoPaciente?

  @@index([contaId])
  @@index([expiraEm])
  @@map("paciente_refresh_tokens")
}

/// Status do dispatch push (worker `PushDispatcherWorker`).
/// `PENDENTE` — recém-criada, aguardando worker
/// `ENVIADO` — push entregue com sucesso pelo provider
/// `FALHOU` — provider rejeitou (ex: token expirado, ntfy unreachable)
/// `EXCEDIDO` — todas as tentativas esgotadas (dead-letter)
/// `SEM_DEVICE` — paciente não tem dispositivo registrado (push pulado)
enum StatusPushNotificacao {
  PENDENTE
  ENVIADO
  FALHOU
  EXCEDIDO
  SEM_DEVICE
}

model NotificacaoPaciente {
  id                String                  @id @default(uuid())
  contaId           String
  conta             PacienteConta           @relation(fields: [contaId], references: [id], onDelete: Cascade)
  pacienteCpf       String // fallback de match por CPF (caso conta seja criada após o encaminhamento)
  encaminhamentoId  String?
  tipo              TipoNotificacaoPaciente
  titulo            String
  corpo             String
  payload           Json? // dados estruturados (protocolo, anexoId, agendamento, etc.)
  lidaEm            DateTime?
  criadaEm          DateTime                @default(now())

  /// Status do dispatch push (v0.16+). Default PENDENTE → worker tenta enviar.
  pushStatus        StatusPushNotificacao   @default(PENDENTE)
  pushTentativas    Int                     @default(0)
  pushUltimaTentativaEm DateTime?
  pushEnviadoEm     DateTime?
  pushErro          String?                 @db.Text

  @@index([contaId, criadaEm])
  @@index([pacienteCpf, criadaEm])
  @@index([encaminhamentoId])
  @@index([pushStatus, criadaEm])
  @@map("notificacoes_paciente")
}

// ============================================================
// Banners SMS (P2 — comunicados da Secretaria Municipal de Saúde)
// ============================================================

enum BannerTone {
  URGENTE     // vermelho — emergência sanitária
  CAMPANHA    // verde — campanha positiva (vacinação)
  INFO        // azul — informativo neutro
  ATENCAO     // âmbar — atenção sem urgência
}

/// Banner exibido no carrossel "Avisos da Secretaria" da home do app paciente.
/// Curadoria por ADMIN/REGULADOR_SMS. Filtro automático por ativo + não expirado.
model SmsBanner {
  id              String     @id @default(uuid())
  titulo          String
  corpo           String
  tone            BannerTone
  publicadoEm     DateTime   @default(now())
  expiraEm        DateTime?
  imagemUrl       String?    // HTTPS (Android bloqueia HTTP)
  ctaLabel        String?
  ctaUrl          String?    // HTTPS obrigatório
  prioridadeOrdem Int        @default(0)
  ativo           Boolean    @default(true)

  /// Escopo opcional — quando null, banner global; quando setado, só pacientes
  /// dessa prefeitura veem (filtro por `ubsVinculada.prefeituraId`).
  prefeituraId    String?
  prefeitura      Prefeitura? @relation("BannerPrefeitura", fields: [prefeituraId], references: [id])

  criadoPorId     String
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt

  visualizacoes   SmsBannerView[]

  @@index([ativo, expiraEm])
  @@index([prefeituraId, ativo])
  @@map("sms_banners")
}

/// Telemetria — 1 view por (banner, paciente). UPSERT idempotente.
model SmsBannerView {
  id         String        @id @default(uuid())
  bannerId   String
  banner     SmsBanner     @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  contaId    String
  conta      PacienteConta @relation("BannerView", fields: [contaId], references: [id], onDelete: Cascade)
  vistoEm    DateTime      @default(now())

  @@unique([bannerId, contaId])
  @@map("sms_banner_views")
}

// ============================================================
// TFD do paciente (P2 — solicitações de vaga via app)
// ============================================================

enum TfdPacienteStatus {
  AGUARDANDO
  APROVADA
  RECUSADA
  CANCELADA
  EMBARCADA
  CONCLUIDA
}

enum TfdPacientePrioridade {
  NORMAL
  PRIORITARIA
  URGENTE
}

/// Pedido de vaga TFD feito pelo paciente via app. Anti-fraude:
/// índice (contaId, viagemId) garante 1 pedido ATIVO por (paciente, viagem).
///
/// Quando aprovado por gestor TFD, o atendente também aloca em `ViagemPassageiro`
/// (Face 4) — esta tabela é a "solicitação", a alocação é separada.
model TfdPacienteSolicitacao {
  id           String @id @default(uuid())
  contaId      String
  conta        PacienteConta @relation("TfdContaSolic", fields: [contaId], references: [id])
  viagemId     String
  viagem       ViagemFrota @relation("TfdViagemSolic", fields: [viagemId], references: [id])

  status       TfdPacienteStatus     @default(AGUARDANDO)
  prioridade   TfdPacientePrioridade @default(NORMAL)
  justificativaPaciente String
  acompanhante String?
  encaminhamentoId String?
  encaminhamento Encaminhamento? @relation("TfdEncaminhamento", fields: [encaminhamentoId], references: [id])
  encaminhamentoProtocolo String?

  numeroAssento  String?
  motivoRecusa   String?

  /// Operador (atendente Face 4) que aprovou/recusou — preenchido em transição.
  operadorId       String?
  operadorNome     String?
  operadorMatricula String?

  criadaEm     DateTime @default(now())
  aprovadaEm   DateTime?
  recusadaEm   DateTime?
  canceladaEm  DateTime?

  /// Contagem de re-tentativas após recusa/cancelamento.
  /// Anti-spam: limite no use case (default 3).
  tentativasReabertura Int @default(0)

  @@unique([contaId, viagemId])
  @@index([contaId, criadaEm])
  @@index([viagemId])
  @@index([status, prioridade, criadaEm])
  @@map("tfd_paciente_solicitacoes")
}

// ============================================================
// Outbox Events (event-driven · at-least-once delivery)
// ============================================================

model OutboxEvent {
  id            String   @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  criadoEm      DateTime @default(now())
  publicadoEm   DateTime?
  tentativas    Int      @default(0)
  ultimoErro    String?

  @@index([publicadoEm, criadoEm])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ============================================================
// AUDITORIA DE PRONTUÁRIO (Res. CFM 1.821/2007 · retenção 20 anos)
// ============================================================

enum AcaoProntuario {
  ADD_ALERGIA
  REMOVE_ALERGIA
  ADD_CONDICAO_CRONICA
  UPDATE_CONDICAO_CRONICA
  REMOVE_CONDICAO_CRONICA
  ADD_MEDICAMENTO
  UPDATE_MEDICAMENTO
  REMOVE_MEDICAMENTO
  SET_HISTORICO_FAMILIAR
  ADD_ATENDIMENTO
  REMOVE_ATENDIMENTO
  ADD_EXAME
  REMOVE_EXAME
  ADD_VACINA
  REMOVE_VACINA
  ADD_VIAGEM_TFD
  UPDATE_VIAGEM_TFD
  REMOVE_VIAGEM_TFD
  /// Paciente baixou anexo do próprio prontuário (Face 3).
  /// Retenção CFM 20 anos — `dados` traz `anexoId`, `mimeType`, `size`, `ip`, `userAgent`.
  DOWNLOAD_ANEXO
  /// Paciente visualizou seu dossiê médico (Face 3 — endpoints `/dossie/*`).
  /// Retenção CFM 20 anos — rastreabilidade de acesso ao prontuário.
  LEITURA_DOSSIE
}

/**
 * Registro imutável de toda operação sobre o prontuário.
 *
 * Append-only: nunca deletar. Retenção mínima 20 anos (Res. CFM 1.821/2007 art. 8º).
 * Nunca expor PII do paciente aqui — só IDs e metadados; a PII vai em `dados` (JSON)
 * já em formato mascarado quando aplicável.
 */
model PacienteProntuarioAudit {
  id          String          @id @default(uuid())
  pacienteId  String
  autorId     String          // atendenteId
  autorNome   String          // snapshot (usado em relatório mesmo se atendente for deletado)
  autorPapel  String          // "ATENDENTE_UBS · UBS Central"
  acao        AcaoProntuario
  recursoId   String?         // id do sub-documento afetado (alergiaId, atendimentoId, etc.)
  dados       Json            // snapshot do payload (útil pra auditor reconstruir operação)
  ip          String?
  userAgent   String?
  em          DateTime        @default(now())

  @@index([pacienteId, em])
  @@index([autorId, em])
  @@index([acao, em])
  @@map("paciente_prontuario_audit")
}

