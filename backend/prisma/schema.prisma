model MotoristaTFD {
  id              String  @id @default(uuid())
  prefeituraId    String
  prefeitura      Prefeitura @relation("MotoristaPrefeitura", fields: [prefeituraId], references: [id])
  nome            String
  cpf             String   // só dígitos
  cnh             String
  categoriaCnh    CategoriaCNH
  validadeCnh     DateTime
  telefone        String
  status          StatusMotoristaTFD @default(ATIVO)
  totalViagens    Int     @default(0)
  totalKmRodados  BigInt  @default(0)

  // Face 4 (app motorista) — vínculo 1:1 com Atendente (role=MOTORISTA_TFD).
  // Permite login no app mobile, troca de senha, push notification.
  atendenteId   String?    @unique
  atendente     Atendente? @relation("AtendenteMotorista", fields: [atendenteId], references: [id])
  primeiroLogin Boolean    @default(true)
  fcmToken      String?    // Firebase Cloud Messaging — preenchido pelo app após login

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  deletadoEm   DateTime?
  criadoPorId  String

  viagens         ViagemFrota[]
  abastecimentos  Abastecimento[]

  @@index([prefeituraId, status, deletadoEm])
  @@index([cpf])
  @@map("tfd_motoristas")
}

// ----- Solicitações -----
model SolicitacaoTFD {
  id                       String   @id @default(uuid())
  protocolo                String   @unique // TFD-AAAA-NNNNNN
  prefeituraId             String
  prefeitura               Prefeitura @relation("SolicTfdPrefeitura", fields: [prefeituraId], references: [id])
  pacienteId               String
  paciente                 Paciente   @relation(fields: [pacienteId], references: [id])

  // Snapshot / Dados do Paciente
  pacienteCpf              String?
  pacienteNome             String?
  pacienteDataNasc         DateTime?
  pacienteTelefone         String?
  pacienteEndereco         String?
  pacienteCartaoSus        String?
  pacienteNomeMae          String?
  pacienteRg               String?
  pacienteBairro           String?
  pacienteMunicipio        String?
  pacienteUf               String?
  pacienteCep              String?
  ubsId                    String
  ubs                      Ubs        @relation("SolicTfdUbs", fields: [ubsId], references: [id])
  encaminhamentoOrigemId   String?
  destino                  String
  unidadeDestino           String?
  especialidade            String
  motivo                   String
  dataDesejada             DateTime
  acompanhanteNecessario   Boolean  @default(false)
  acompanhanteNome         String?
  acompanhanteCpf          String?
  acompanhanteDataNasc     DateTime?
  acompanhanteTelefone     String?
  acompanhanteParentesco   String?
  acompanhanteRg           String?

  // Registro Tardio / Lançamento Retroativo
  isRegistroTardio             Boolean   @default(false)
  justificativaRegistroTardio   String?
  dataRealizadaRetroativa      DateTime?
  comprovanteHospitalDestino   String?

  prioridade               PrioridadeSolicTFD
  status                   StatusSolicitacaoTFD @default(PENDENTE)
  observacoes              String?
  motivoNegacao            String?

  viagemId                 String?
  viagem                   ViagemFrota? @relation(fields: [viagemId], references: [id])

  criadaEm    DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  decididaEm  DateTime?
  decididaPorId String?
  deletadaEm  DateTime?

  anexos      AnexoSolicitacaoTFD[]
  passageiros ViagemPassageiro[]

  @@index([prefeituraId, status, criadaEm])
  @@index([pacienteId])
  @@map("tfd_solicitacoes")
}

model AnexoSolicitacaoTFD {
  id            String         @id @default(uuid())
  solicitacaoId String
  solicitacao   SolicitacaoTFD @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  tipo          TipoAnexoTFD?
  tipoLegado    TipoAnexoSolicTFD?
  nome          String?
  nomeArquivo   String?
  mimeType      String?
  tamanhoKb     Int?
  tamanhoBytes  Int?
  storageKey    String?
  url           String?
  scanStatus    StatusScanAnexo @default(PENDENTE)
  scanEm        DateTime?
  uploadEm      DateTime       @default(now())
  uploadPorId   String?
  criadoEm      DateTime       @default(now())

  @@index([solicitacaoId])
  @@map("tfd_solicitacao_anexos")
}

// ----- Viagens -----
model ViagemFrota {
  id                    String   @id @default(uuid())
  codigoViagem          String?  @unique // Ex: VTFD-2026-0803-XXXX
  prefeituraId          String
  prefeitura            Prefeitura @relation("ViagemFrotaPrefeitura", fields: [prefeituraId], references: [id])
  data                  DateTime  // date only (YYYY-MM-DD UTC)
  horaSaida             String    // HH:mm
  horaPrevistaRetorno   String?
  veiculoId             String?
  veiculo               VeiculoTFD? @relation(fields: [veiculoId], references: [id])
  motoristaId           String?
  motorista             MotoristaTFD? @relation(fields: [motoristaId], references: [id])
  destino               String
  unidadeDestino        String?
  rotaResumo            String?
  kmEstimados           Int?
  kmInicialHodometro    BigInt?
  kmFinalHodometro      BigInt?

  // Controle e Auditoria de KM pelo Gestor (Carro Baixo / Frota)
  kmGestorRegistradoPor String?        // UserId do Gestor
  kmGestorDataRegistro DateTime?
  justificativaKmGestor String?

  // Registro Tardio de Viagem
  isRegistroTardio     Boolean          @default(false)
  justificativaTardia  String?

  vagasTotais           Int
  observacoes           String?
  status                StatusViagemFrota @default(AGENDADA)

  criadaEm        DateTime @default(now())
  criadaPorId     String
  iniciadaEm      DateTime?
  concluidaEm     DateTime?
  motivoCancelamento String?

  /// Auto-touch em qualquer escrita no model. Usado pelo app do motorista
  /// como cursor de sync incremental (`GET /motorista-app/minhas-viagens?desde=ISO`).
  /// Mudança em passageiro também faz "touch" via update explícito no use case.
  atualizadoEm    DateTime @default(now()) @updatedAt

  passageiros     ViagemPassageiro[]
  abastecimentos  Abastecimento[]
  ajudasCusto     AjudaCusto[]
  solicitacoes    SolicitacaoTFD[]
  /// Pedidos de vaga feitos por pacientes via app (Face 3).
  solicitacoesPaciente TfdPacienteSolicitacao[]  @relation("TfdViagemSolic")

  @@index([prefeituraId, status, data])
  @@index([veiculoId, data])
  @@index([motoristaId, data])
  @@index([motoristaId, atualizadoEm])
  @@map("tfd_viagens")
}

model ViagemPassageiro {
  id              String  @id @default(uuid())
  viagemId        String
  viagem          ViagemFrota @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  solicitacaoId   String
  solicitacao     SolicitacaoTFD @relation(fields: [solicitacaoId], references: [id])
  pacienteId      String
  paciente        Paciente @relation("PacienteViagemPassageiro", fields: [pacienteId], references: [id])
  /// Assento escolhido (BlaBlaCar style). Opcional — se null, é alocação livre.
  /// Quando preenchido, exclusivo dentro da viagem.
  numeroAssento   Int?
  acompanhante    Boolean @default(false)
  presenca        PresencaPassageiro @default(AGUARDANDO)
  observacao      String?
  marcadoEm       DateTime?
  marcadoPorId    String?

  @@unique([viagemId, solicitacaoId])
  @@unique([viagemId, numeroAssento])
  @@index([viagemId])
  @@map("tfd_viagem_passageiros")
}

// ----- Abastecimento -----
model Abastecimento {
  id              String  @id @default(uuid())
  protocolo       String  @unique  // ABT-AAAA-NNNNNN
  prefeituraId    String
  prefeitura      Prefeitura @relation("AbastPrefeitura", fields: [prefeituraId], references: [id])
  veiculoId       String
  veiculo         VeiculoTFD @relation(fields: [veiculoId], references: [id])
  motoristaId    String?
  motorista      MotoristaTFD? @relation(fields: [motoristaId], references: [id])
  viagemId       String?
  viagem         ViagemFrota? @relation(fields: [viagemId], references: [id])
  posto          String
  litros         Decimal  @db.Decimal(8, 2) @default(0)
  combustivel    CombustivelVeiculo
  valorPorLitro  Decimal  @db.Decimal(8, 3) @default(0)
  valorEstimado  Decimal  @db.Decimal(12, 2) @default(0)
  valorTotal     Decimal  @db.Decimal(12, 2) @default(0)
  hodometroKm    BigInt   @default(0)
  kmDesdeUltimo  Int?
  consumoCalcKml Decimal? @db.Decimal(5, 2)
  status         StatusAbastecimento @default(SOLICITADO)
  comprovanteKey String?
  motivoNegacao  String?

  solicitadoEm   DateTime @default(now())
  solicitadoPorId String
  liberadoEm     DateTime?
  liberadoPorId  String?
  realizadoEm    DateTime?
  realizadoPorId String?

  @@index([prefeituraId, status, solicitadoEm])
  @@index([veiculoId, solicitadoEm])
  @@map("tfd_abastecimentos")
}

// ----- Saldo -----
model SaldoVeiculo {
  veiculoId         String
  veiculo           VeiculoTFD @relation(fields: [veiculoId], references: [id])
  prefeituraId      String
  prefeitura        Prefeitura @relation("SaldoVeicPrefeitura", fields: [prefeituraId], references: [id])
  mes               String    // YYYY-MM
  saldoMensal       Decimal   @db.Decimal(14, 2)
  saldoConsumido    Decimal   @db.Decimal(14, 2) @default(0)
  saldoReservado    Decimal   @db.Decimal(14, 2) @default(0)

  atualizadoEm DateTime @updatedAt

  @@id([veiculoId, mes])
  @@index([prefeituraId, mes])
  @@map("tfd_saldo_veiculo")
}

model SaldoAjuste {
  id             String  @id @default(uuid())
  veiculoId      String
  prefeituraId   String
  mes            String
  saldoAnterior  Decimal @db.Decimal(14, 2)
  saldoNovo      Decimal @db.Decimal(14, 2)
  justificativa  String
  ajustadoPorId  String
  ajustadoEm     DateTime @default(now())

  @@index([veiculoId, mes])
  @@map("tfd_saldo_ajustes")
}

// ----- Ajuda de Custo -----
model AjudaCusto {
  id                          String   @id @default(uuid())
  protocolo                   String   @unique  // AJC-AAAA-NNNNNN
  prefeituraId                String
  prefeitura                  Prefeitura @relation("AjudaPrefeitura", fields: [prefeituraId], references: [id])
  viagemId                    String
  viagem                      ViagemFrota @relation(fields: [viagemId], references: [id])
  pacienteId                  String
  paciente                    Paciente @relation("PacienteAjudaCusto", fields: [pacienteId], references: [id])
  itens                       Json    // [{ categoria, descricao, valorBRL }]
  valorTotal                  Decimal @db.Decimal(12, 2)
  status                      StatusAjudaCusto @default(PENDENTE)
  metodoPagamento             MetodoPagamentoAjuda?
  comprovantePagamentoKey     String?
  motivoNegacao               String?

  criadaEm       DateTime @default(now())
  criadaPorId    String
  autorizadaEm   DateTime?
  autorizadaPorId String?
  pagaEm         DateTime?
  pagaPorId      String?

  @@unique([viagemId, pacienteId])
  @@index([prefeituraId, status, criadaEm])
  @@map("tfd_ajudas_custo")
}

// ----- Auditoria TJ (cadeia hash imutável) -----
model TfdAuditLog {
  id                String  @id @default(uuid())
  prefeituraId      String
  prefeitura        Prefeitura @relation("TfdAuditPrefeitura", fields: [prefeituraId], references: [id])
  acao              AcaoAuditoriaTFD
  recursoTipo       String
  recursoId         String
  recursoProtocolo  String?
  operadorId        String
  operadorNome      String
  operadorMatricula String
  operadorRole      String
  ip                String
  userAgent         String
  antes             Json?
  depois            Json?
  hashAnterior      String   // SHA-256 (64 hex chars)
  hash              String   // SHA-256(this | hashAnterior)
  em                DateTime @default(now())

  @@index([prefeituraId, em(sort: Desc)])
  @@index([recursoTipo, recursoId, em(sort: Desc)])
  @@index([acao, em])
  @@map("tfd_audit_log")
}
// ============================================================
// Models e enums MERGEADOS do remote 'versão simplificada'
// (TFD avançado: aportes financeiros + saldo ajuda custo + idempotency)
// ============================================================

// === Enum ===
enum FonteRecursoTFD {
  EMPENHO
  PORTARIA
  REPASSE_FEDERAL
  REPASSE_ESTADUAL
  REMANEJAMENTO
  OUTRO
}

// === Models ===

model TfdIdempotencyKey {
  hash         String   @id          // sha256(operadorId|key|method|path)
  operadorId   String
  method       String
  path         String
  statusCode   Int
  responseJson Json
  criadoEm     DateTime @default(now())
  expiraEm     DateTime

  @@index([operadorId, criadoEm])
  @@index([expiraEm])
  @@map("tfd_idempotency_keys")
}

model AporteSaldoFrota {
  id              String  @id @default(uuid())
  prefeituraId    String
  prefeitura      Prefeitura @relation("AporteFrotaPrefeitura", fields: [prefeituraId], references: [id])
  veiculoId       String?
  rateioGeral     Boolean @default(false)
  /// Identifica os N registros gerados num único `aportar` com rateio.
  grupoRateioId   String?
  mes             String   // YYYY-MM
  valorBRL        Decimal  @db.Decimal(14, 2)
  fonte           FonteRecursoTFD
  numeroDocumento String?
  descricaoFonte  String?
  justificativa   String
  operadorId      String
  criadoEm        DateTime @default(now())

  @@index([prefeituraId, mes, criadoEm])
  @@index([veiculoId, mes])
  @@index([grupoRateioId])
  @@map("tfd_saldo_frota_aportes")
}

model AporteSaldoAjudaCusto {
  id              String  @id @default(uuid())
  prefeituraId    String
  prefeitura      Prefeitura @relation("AporteAjudaPrefeitura", fields: [prefeituraId], references: [id])
  mes             String
  valorBRL        Decimal  @db.Decimal(14, 2)
  fonte           FonteRecursoTFD
  numeroDocumento String?
  descricaoFonte  String?
  justificativa   String
  operadorId      String
  criadoEm        DateTime @default(now())

  @@index([prefeituraId, mes, criadoEm])
  @@map("tfd_saldo_ajuda_aportes")
}

model SaldoAjudaCusto {
  prefeituraId      String
  prefeitura        Prefeitura @relation("SaldoAjudaPrefeitura", fields: [prefeituraId], references: [id])
  mes               String     // YYYY-MM
  saldoMensal       Decimal    @db.Decimal(14, 2) @default(0)
  saldoConsumido    Decimal    @db.Decimal(14, 2) @default(0)
  saldoReservado    Decimal    @db.Decimal(14, 2) @default(0)
  tetoAlimentacao   Decimal    @db.Decimal(12, 2) @default(0)
  tetoHospedagem    Decimal    @db.Decimal(12, 2) @default(0)
  tetoDeslocamento  Decimal    @db.Decimal(12, 2) @default(0)

  atualizadoEm DateTime @updatedAt

  @@id([prefeituraId, mes])
  @@map("tfd_saldo_ajuda_custo")
}

model SaldoAjudaCustoAjuste {
  id                       String  @id @default(uuid())
  prefeituraId             String
  mes                      String
  saldoAnterior            Decimal @db.Decimal(14, 2)
  saldoNovo                Decimal @db.Decimal(14, 2)
  tetoAlimentacaoAnterior  Decimal @db.Decimal(12, 2)
  tetoAlimentacaoNovo      Decimal @db.Decimal(12, 2)
  tetoHospedagemAnterior   Decimal @db.Decimal(12, 2)
  tetoHospedagemNovo       Decimal @db.Decimal(12, 2)
  tetoDeslocamentoAnterior Decimal @db.Decimal(12, 2)
  tetoDeslocamentoNovo     Decimal @db.Decimal(12, 2)
  justificativa            String
  ajustadoPorId            String
  ajustadoEm               DateTime @default(now())

  @@index([prefeituraId, mes])
  @@map("tfd_saldo_ajuda_ajustes")
}

model ConfiguracaoIntegracao {
  id           String   @id @default(uuid())
  nome         String   @unique // ex: 'CADSUS', 'e-SUS APS', 'SISREG', 'Webhook UBS'
  url          String
  usuario      String?
  senha        String?
  token        String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes_integracao")
}

// ============================================================
// CENTRO MUNICIPAL DE ESPECIALIDADES (Escalas & Cotas)
// ============================================================

model EscalaEspecialista {
  id              String             @id @default(uuid())
  prefeituraId    String?
  medicoId        String?
  medicoNome      String
  crm             String
  especialidade   String
  tipoServico     TipoServicoCentro  @default(CONSULTA)
  procedimentoId  String?            // ID opcional do catálogo SIGTAP se tipoServico == PROCEDIMENTO
  diasSemana      String[]           // ["SEG", "TER", "QUA", "QUI", "SEX"]
  horarioInicio   String             // "08:00"
  horarioFim      String             // "12:00"
  duracaoMinutos         Int                @default(20)
  vagasPorTurno          Int                @default(12)
  status                 StatusAgendaMedica @default(ATIVA)
  ativo                  Boolean            @default(true)

  // Recorrência flexível & Mini Mutirão
  tipoRecorrencia        String             @default("SEMANAL") // "SEMANAL" | "QUINZENAL" | "DATAS_ESPECIFICAS" | "MUTIRAO"
  datasEspecificas       String[]           @default([])        // Datas pontuais YYYY-MM-DD
  isMutirao              Boolean            @default(false)
  intervaloDias          Int?               @default(7)         // 7 para semanal, 14 para quinzenal
  dataInicioRecorrencia  String?                                // Data de início para o ciclo quinzenal (YYYY-MM-DD)

  criadoEm        DateTime           @default(now())
  atualizadoEm    DateTime           @updatedAt
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@map("escalas_especialistas")
}

model CotaUbs {
  id            String   @id @default(uuid())
  ubsId         String   @unique
  totalCotasMes Int      @default(350)
  especialidades Json
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@map("cotas_ubs")
}

enum StatusSalaConsultorio {
  DISPONIVEL
  EM_ATENDIMENTO
  MANUTENCAO
  RESERVADA
}

model SalaConsultorio {
  id                     String                @id @default(uuid())
  codigo                 String
  nome                   String
  especialidadePrincipal String
  status                 StatusSalaConsultorio @default(DISPONIVEL)
  equipamentos           String[]
  ala                    String?
  prefeituraId           String?

  criadoEm               DateTime              @default(now())
  atualizadoEm           DateTime              @updatedAt

  @@map("salas_consultorios")
}

model EspecialidadeCatalogo {
  id                     String   @id @default(uuid())
  nome                   String
  codigoSigtap           String?
  tempoPadraoMinutos     Int      @default(20)
  valorTabelaBrl         Float    @default(0)
  documentosObrigatorios String[]
  preparoRequerido       String?
  ativa                  Boolean  @default(true)
  prefeituraId           String?

  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  @@map("especialidades_catalogo")
}

// ============================================================
// CENTRO DE ESPECIALIDADES & REGULAÇÃO
// ============================================================

enum TipoServicoCentro {
  CONSULTA
  PROCEDIMENTO
}

enum StatusAgendaMedica {
  ATIVA
  FERIAS
  LICENCA
  BLOQUEADA
}

enum ModoDataAgendamento {
  AUTODATA
  MANUAL
  RETROATIVO
}

enum StatusAgendamentoCentro {
  AGUARDANDO
  EM_ATENDIMENTO
  CONCLUIDO
  FALTOU
  CANCELADO
}

model AtendimentoProcedimentoRealizado {
  id              String             @id @default(uuid())
  atendimentoId   String?
  atendimento     Atendimento?       @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  agendamentoId   String?
  agendamento     AgendamentoCentro? @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  codigoSigtap    String?     // Ex: "02.11.02.003-6"
  nome            String      // Ex: "Eletrocardiograma (ECG)"
  quantidade      Int         @default(1)
  valorUnitario   Float       @default(0.0)
  observacao      String?

  registradoPorId String?     // ID do Médico ou Atendente
  registradoEm    DateTime    @default(now())

  @@map("atendimento_procedimentos_realizados")
}

model AgendamentoCentro {
  id                   String                  @id @default(uuid())
  protocolo            String                  @unique // Ex: BALCAO-2026-XXXX
  prefeituraId         String?
  pacienteId           String
  paciente             Paciente                @relation(fields: [pacienteId], references: [id])
  medicoId             String?
  medicoNome           String?
  especialidade        String
  tipoServico          TipoServicoCentro       @default(CONSULTA)
  procedimentoNome     String?

  // Datas & Modo Retroativo
  modoData             ModoDataAgendamento     @default(AUTODATA)
  dataAgendamento      DateTime
  horaAgendamento      String
  status               StatusAgendamentoCentro @default(AGUARDANDO)

  // Procedimentos múltiplos efetuados no atendimento
  procedimentos        AtendimentoProcedimentoRealizado[]

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("agendamentos_centro")
}
