{
  "name": "unisism-ubs-backend",
  "version": "0.18.3",
  "description": "Backend da Face 1 (UBS) do sistema UNISISM — atendimento, encaminhamentos e PEC.",
  "main": "dist/main/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/main/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/server.js",
    "start:container": "npm run prisma:deploy && node dist/main/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js",
    "minio:init": "ts-node-dev --transpile-only scripts/init-minio.ts",
    "db:setup-triggers": "ts-node-dev --transpile-only scripts/setup-db-triggers.ts",
    "db:validate-migrations": "bash scripts/db/validate-migrations.sh",
    "db:backfill-motoristas": "ts-node-dev --transpile-only scripts/backfill-motoristas.ts",
    "db:seed-recomendacoes": "ts-node-dev --transpile-only scripts/seed-recomendacoes.ts",
    "tfd:rebuild-audit-chain": "ts-node-dev --transpile-only scripts/rebuild-tfd-audit-chain.ts",
    "setup": "bash scripts/setup.sh",
    "test": "ts-node --transpile-only tests/ubs-atendimento.test.ts && ts-node --transpile-only tests/centro.test.ts && ts-node --transpile-only tests/whatsapp-crm.test.ts && ts-node --transpile-only tests/e2e-fluxo-integrado.test.ts",
    "test:unit": "ts-node --transpile-only tests/ubs-atendimento.test.ts && ts-node --transpile-only tests/centro.test.ts",
    "test:ubs": "ts-node --transpile-only tests/ubs-atendimento.test.ts",
    "test:e2e": "ts-node --transpile-only tests/e2e-fluxo-integrado.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:ts": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint src tests",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/**/*.js' --test-coverage-exclude='dist/prisma/**' --test-coverage-exclude='dist/scripts/**' --test-coverage-lines=60 --test-coverage-functions=50 --test-coverage-branches=50 tests/*.test.js && ts-node --transpile-only tests/centro.test.ts",
    "test:smoke:app": "bash scripts/smoke-test-app-contract.sh",
    "test:smoke:http": "bash scripts/smoke/run-http-suite.sh",
    "test:smoke:critical": "bash scripts/smoke/run-critical-flows.sh",
    "test:smoke:security": "bash scripts/smoke/run-security.sh",
    "test:smoke:reliability": "bash scripts/smoke/run-reliability.sh",
    "test:smoke:production": "npx ts-node --transpile-only scripts/smoke-test-etapa12.ts",
    "test:smoke:all": "bash scripts/smoke/run-all.sh",
    "validate": "npm run typecheck && npm run lint:ts && npm run lint && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "clamscan": "^2.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-csv": "^5.0.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/clamscan": "^2.4.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.60.0",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
