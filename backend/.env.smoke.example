# Ambiente isolado para smokes automatizados.
# Copie para `.env.smoke` se quiser personalizar. O runner tambem consegue
# derivar `unisism_ubs_smoke` a partir do DATABASE_URL do `.env`.

NODE_ENV=development
PORT=3334
BACKEND_PORT=3334
CORS_ALLOW_VERCEL_PREVIEW=false
SHUTDOWN_GRACE_MS=10000

# Banco separado do desenvolvimento local. O nome precisa conter "smoke",
# "test", "testing" ou "ci", salvo se SMOKE_ALLOW_NON_ISOLATED_DB=true.
SMOKE_DATABASE_URL="postgresql://unisism:unisism@localhost:5432/unisism_ubs_smoke?schema=public"

API_KEY=unisism-smoke-secret-key-2026
API_KEY_HEADER=x-api-key

# Reduz ruido e efeitos colaterais durante smoke.
DEMO_SEED_ON_BOOT=false
OUTBOX_ENABLED=false
PUSH_DISPATCHER_ENABLED=false
NTFY_BASE_URL=https://ntfy.example.com
METRICS_ENABLED=true
EMAIL_PROVIDER=log
STORAGE_PROVIDER=disk
UPLOAD_DIR=./uploads-smoke
