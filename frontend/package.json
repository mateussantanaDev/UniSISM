{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:eslint",
		"lint:eslint": "eslint . --suppressions-location .eslint-suppressions.json --pass-on-unpruned-suppressions",
		"lint:eslint:baseline": "eslint .",
		"lint:eslint:refresh": "eslint . --suppress-all --suppressions-location .eslint-suppressions.json --pass-on-unpruned-suppressions && eslint . --suppressions-location .eslint-suppressions.json --prune-suppressions --pass-on-unpruned-suppressions && prettier --write .eslint-suppressions.json && npm run lint:eslint",
		"lint:format": "prettier --check .",
		"playwright:install": "playwright install chromium",
		"test:unit": "vitest",
		"test:server": "vitest --run --project server",
		"test:browser": "vitest --run --project client --passWithNoTests",
		"test:coverage": "vitest --run --project server --coverage",
		"test": "npm run test:server",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"postcss": "^8.5.10",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@tabler/icons-svelte": "^3.46.0",
		"html2pdf.js": "^0.14.0",
		"vercel": "^59.25.4"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
	}
}
